{
  "name": "concord",
  "version": "1.1.0",
  "description": "Concord - chat, voz, vídeo e compartilhamento de tela para Windows 11",
  "author": "Concord",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path'); const src=path.join(process.cwd(),'node_modules','socket.io','client-dist','socket.io.min.js'); if(fs.existsSync(src)) fs.copyFileSync(src, path.join(process.cwd(),'socket.io.min.js'));\"",
    "dist": "electron-builder",
    "test": "node --test \"test/*.test.js\""
  },
  "build": {
    "appId": "com.seunome.concord",
    "productName": "Concord",
    "asar": true,
    "files": [
      "**/*",
      "!users.json",
      "!messages.json",
      "!dist/**",
      "!README.md",
      "!AGENTS.md",
      "!tools/**",
      "!IniciarTunelConcord.bat",
      "!*.log",
      "!test/**",
      "!docs/**",
      "!.superpowers/**"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Concord"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "socket.io": "^4.7.0"
  }
}
