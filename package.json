{
  "name": "vox",
  "version": "1.5.4",
  "description": "Vox - chat, voz, vídeo e compartilhamento de tela para Windows 11",
  "author": "Vox",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path'); const src=path.join(process.cwd(),'node_modules','socket.io','client-dist','socket.io.min.js'); if(fs.existsSync(src)) fs.copyFileSync(src, path.join(process.cwd(),'socket.io.min.js'));\"",
    "dist": "electron-builder --publish never",
    "test": "node --test \"test/*.test.js\""
  },
  "build": {
    "appId": "com.seunome.concord",
    "productName": "Vox",
    "asar": true,
    "files": [
      "**/*",
      "!users.json",
      "!messages.json",
      "!uploads/**",
      "!avatars/**",
      "!sessions.json",
      "!servers.json",
      "!friends.json",
      "!music-history.json",
      "!soundboard.json",
      "!soundboard/**",
      "!dist/**",
      "!README.md",
      "!AGENTS.md",
      "!tools/**",
      "!IniciarTunelVox.bat",
      "!*.log",
      "!test/**",
      "!scripts/**",
      "!build/**",
      "!assets/icon-small.svg",
      "!docs/**",
      "!.superpowers/**"
    ],
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vox",
      "artifactName": "Vox-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "viniciusog1",
        "repo": "vox"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^24.0.0",
    "rcedit": "^4.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "socket.io": "^4.7.0"
  }
}
